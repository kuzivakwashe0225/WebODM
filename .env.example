WO_HOST=localhost
WO_PORT=8000
WO_MEDIA_DIR=appmedia
WO_DB_DIR=dbdata
WO_SSL=NO
WO_SSL_KEY=
WO_SSL_CERT=
WO_SSL_INSECURE_PORT_REDIRECT=80
WO_DEBUG=NO
WO_DEV=NO
WO_BROKER=redis://broker
WO_DEFAULT_NODES=1
WO_SETTINGS=

# AgriTrack mobile app integration (see precise-agric/stages/stage-7-agritrack-integration.md)
WO_AGRITRACK_INBOUND_API_KEY=
WO_AGRITRACK_SYNC_OWNER_USERNAME=
WO_AGRITRACK_RESULTS_PUSH_URL=
WO_AGRITRACK_OUTBOUND_API_KEY=
WO_AGRITRACK_PUBLIC_BASE_URL=

# Remote-sense (Sentinel) GeoTIFF ingestion (see agri/remote_sense/)
# Key the remote-sense system sends as X-Api-Key on POST /api/v1/remote-sense/push.
WO_REMOTE_SENSE_INBOUND_API_KEY=
# Base URL of the remote-sense host, ONLY needed for the optional URL-pull mode
# (POST {farm_id, image_url}); leave blank to allow direct file push only.
WO_REMOTE_SENSE_BASE_URL=

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
WO_SECRET_KEY=
